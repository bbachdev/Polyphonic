//Used for Discord RP
VITE_DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

//Share Service API URL and API Key (for sharing songs/albums to Discord/social media)
//If not set, defaults to http://localhost:7636
VITE_SHARE_API_URL=
//REQUIRED: API key for the share service (generate with: openssl rand -hex 32)
//Must match the API_KEY set in the Polyphonic-Share service
VITE_SHARE_API_KEY=